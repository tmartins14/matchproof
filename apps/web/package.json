{
  "name": "matchproof-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "serve out -l 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "gen:types": "node ../../scripts/gen_types.mjs",
    "test": "vitest run",
    "shots": "NEXT_PUBLIC_API_URL=http://localhost:8000 next build && playwright test e2e/shots.spec.ts --config playwright.config.ts",
    "axe": "playwright test e2e/a11y.spec.ts --config playwright.config.ts"
  },
  "dependencies": {
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "json-schema-to-typescript": "^16.0.0",
    "serve": "^14.2.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
