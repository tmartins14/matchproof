{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matchproof.tylermartins.com/schemas/fact.schema.json",
  "title": "Fact",
  "description": "One computed value. Produced only by Python extractors. The only numbers an agent may state are fact values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "value", "display", "source_ids", "extractor"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/factId" },
    "name": {
      "description": "Machine name in the form metric(args), e.g. field_tilt(home, 55-70) or freeze_frame(ev-000597).home_ahead_of_ball.",
      "type": "string"
    },
    "value": { "type": ["number", "integer", "string", "boolean"] },
    "unit": { "type": "string", "enum": ["", "m", "s", "pct", "xg", "count", "m_s"] },
    "display": {
      "description": "How the number may be written in prose, e.g. 1.18 shown as 1.2. The reconciler accepts only these renderings.",
      "type": "object",
      "additionalProperties": false,
      "required": ["en"],
      "properties": {
        "en": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "es": { "type": "array", "items": { "type": "string" } }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "side": { "$ref": "common.schema.json#/$defs/side" },
        "player_id": { "$ref": "common.schema.json#/$defs/playerId" },
        "period": { "type": "integer", "enum": [1, 2] },
        "t_from": { "$ref": "common.schema.json#/$defs/matchClock" },
        "t_to": { "$ref": "common.schema.json#/$defs/matchClock" }
      }
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.schema.json#/$defs/sourceId" }
    },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" }
      }
    }
  }
}
