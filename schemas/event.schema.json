{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matchproof.tylermartins.com/schemas/event.schema.json",
  "title": "Event",
  "description": "One on-ball or match event. Shape is StatsBomb-inspired; coordinates are absolute (ADR 0007).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "match_id", "seq", "period", "t", "side", "type", "location"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/eventId" },
    "match_id": { "type": "string" },
    "seq": { "type": "integer", "minimum": 0 },
    "period": { "type": "integer", "enum": [1, 2] },
    "t": { "$ref": "common.schema.json#/$defs/matchClock" },
    "side": { "$ref": "common.schema.json#/$defs/side" },
    "player_id": { "$ref": "common.schema.json#/$defs/playerId" },
    "possession_id": { "type": "integer", "minimum": 0 },
    "type": {
      "type": "string",
      "enum": ["kick_off", "pass", "carry", "shot", "pressure", "interception", "tackle", "duel", "clearance", "foul", "card", "corner", "free_kick", "throw_in", "goal_kick", "substitution", "period_start", "period_end"]
    },
    "location": { "$ref": "common.schema.json#/$defs/point" },
    "end_location": { "$ref": "common.schema.json#/$defs/point" },
    "outcome": {
      "type": "string",
      "enum": ["complete", "incomplete", "won", "lost", "goal", "saved", "wide", "blocked", "post", "yellow", "red", "none"]
    },
    "under_pressure": { "type": "boolean" },
    "pass": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recipient_id": { "$ref": "common.schema.json#/$defs/playerId" },
        "length_m": { "type": "number", "minimum": 0 },
        "progressive": { "type": "boolean" },
        "height": { "type": "string", "enum": ["ground", "low", "high"] },
        "difficulty": { "$ref": "common.schema.json#/$defs/unitInterval" },
        "speed_ms": { "type": "number", "minimum": 0, "maximum": 40, "description": "Ball speed in metres per second." }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["xg", "body_part"],
      "properties": {
        "xg": { "type": "number", "minimum": 0, "maximum": 1 },
        "body_part": { "type": "string", "enum": ["right_foot", "left_foot", "head", "other"] },
        "speed_ms": { "type": "number", "minimum": 0 }
      }
    },
    "pressure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "players_committed": { "type": "integer", "minimum": 1, "maximum": 6 }
      }
    },
    "planted_beat_id": {
      "description": "Set when the generator produced this event to satisfy a planted beat.",
      "type": "string",
      "pattern": "^pb-[0-9]{2}$"
    }
  }
}
