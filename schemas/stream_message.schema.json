{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://matchproof.tylermartins.com/schemas/stream_message.schema.json",
  "title": "StreamMessage",
  "description": "One message on the live SSE stream (ADR 0003). The data shape depends on type. claim and verdict are reserved for the agents and carry a claim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["seq", "type", "t", "data"],
  "properties": {
    "seq": { "type": "integer", "minimum": 0, "description": "Starts at 0 and increases by one per message; the SSE id." },
    "type": { "type": "string", "enum": ["status", "event", "frame", "fact", "beat", "claim", "verdict"] },
    "t": { "$ref": "common.schema.json#/$defs/matchClock" },
    "data": {
      "oneOf": [
        { "$ref": "#/$defs/status" },
        { "$ref": "event.schema.json" },
        { "$ref": "position_frame.schema.json" },
        { "$ref": "fact.schema.json" },
        { "$ref": "beat.schema.json" },
        { "$ref": "claim.schema.json" }
      ]
    }
  },
  "allOf": [
    { "if": { "properties": { "type": { "const": "status" } } }, "then": { "properties": { "data": { "$ref": "#/$defs/status" } } } },
    { "if": { "properties": { "type": { "const": "event" } } }, "then": { "properties": { "data": { "$ref": "event.schema.json" } } } },
    { "if": { "properties": { "type": { "const": "frame" } } }, "then": { "properties": { "data": { "$ref": "position_frame.schema.json" } } } },
    { "if": { "properties": { "type": { "const": "fact" } } }, "then": { "properties": { "data": { "$ref": "fact.schema.json" } } } },
    { "if": { "properties": { "type": { "const": "beat" } } }, "then": { "properties": { "data": { "$ref": "beat.schema.json" } } } },
    { "if": { "properties": { "type": { "enum": ["claim", "verdict"] } } }, "then": { "properties": { "data": { "$ref": "claim.schema.json" } } } }
  ],
  "$defs": {
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["pre_match", "live", "half_time", "full_time", "error", "focus", "freeze"],
          "description": "focus: slow playback into a moment, and it says nothing about what is coming. freeze: the freeze frame of event_id follows and playback holds on it."
        },
        "speed": { "type": "integer", "enum": [1, 3, 6], "description": "Match minutes per real second while cruising. Absent in focus and freeze." },
        "event_id": { "$ref": "common.schema.json#/$defs/eventId", "description": "The anchor event, on a freeze status only." },
        "message": { "type": "string", "description": "Viewer-facing text; follows docs/VOICE.md." }
      }
    }
  }
}
